# Copia este archivo a .env y cambia los valores (no subas .env a GitHub)

# Zona horaria
TZ=America/Lima

# URL por la que entras a BookStack (debe coincidir con el navegador, incluido el puerto)
APP_URL=http://localhost:8080
APP_KEY=base64:tu_clave_generada_aqui

# Puerto del host donde escucha nginx (solo 127.0.0.1)
NGINX_PORT=8080

# Base de datos
DB_ROOT_PASSWORD=cambia_root_pass
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=cambia_db_pass

# Usuario del sistema para los archivos de BookStack (en Linux: id -u / id -g)
PUID=1000
PGID=1000

# Detector: ml (T0) | llm | hibrida (T1)
MODO=hibrida
# Puntaje de XGBoost desde el que una peticion pasa al LLM
UMBRAL_ML=0.5

# LLM local. Inicia llama-server en el host antes de levantar el detector:
# llama-server -m <ruta>.gguf --host 127.0.0.1 --port 8091 -ngl 99 -c 8192 -np 1 --no-mmproj --reasoning off --cache-ram 0 --no-webui
LLM_URL=http://host.docker.internal:8091
LLM_NOMBRE=Qwen3.8-27B EfficientThink