# Copia este archivo a .env y cambia los valores (no subas .env a GitHub)

# Zona horaria
TZ=America/Lima

# URL por la que entras a BookStack (debe coincidir con el navegador, incluido el puerto)
APP_URL=http://localhost:8080
APP_KEY=base64:tu_clave_generada_aqui

# Puerto del host donde escucha nginx (solo 127.0.0.1)
NGINX_PORT=8080

# Base de datos
DB_ROOT_PASSWORD=cambia_root_pass
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=cambia_db_pass

# Usuario del sistema para los archivos de BookStack (en Linux: id -u / id -g)
PUID=1000
PGID=1000

# Modelo de ollama qwen2.5-coder:1.5b/llama3.2:3b
OLLAMA_MODEL=qwen2.5-coder:1.5b